# ── Environment & secrets ───────────────────────────────────────────────────────
.env
.env.local
.env.production
.env.*.local
.envrc
# Credentials / keys — never commit
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.json
service-account*.json
