lightning_logs/
runs/                 # TensorBoard
catboost_info/
.neptune/

# ── Historical market data — too large for git (import from external source) ────
*.parquet
*.csv
*.feather
*.arrow
*.npy
*.npz
data/raw/
data/processed/
data/interim/
data/external/
data/cache/
data/exports/
