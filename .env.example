# ── App ──────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string_in_production
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ── Database ─────────────────────────────────────────────────────
DB_PASSWORD=penguinai_dev
DATABASE_URL=postgresql+asyncpg://penguinai:penguinai_dev@localhost:5432/penguinai

# ── Redis / Celery ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Data APIs ────────────────────────────────────────────────────
POLYGON_API_KEY=
IBKR_HOST=127.0.0.1
IBKR_PORT=7497              # 7496/7497 TWS live/paper · 4001/4002 Gateway live/paper
IBKR_CLIENT_ID=1
# Tickers the real-time stream (data/ingestion/ibkr_stream.py) subscribes to (Top-30, ETFs first)
IBKR_TICKERS=QQQ,SPY,IWM,DIA,NVDA,AAPL,MSFT,AMZN,GOOGL,META,TSLA,AVGO,AMD,NFLX,PLTR,COIN,MU,QCOM,JPM,V,GS,LLY,UNH,XOM,CVX,COST,WMT,BAC,ORCL,CRM

# ── Social Media Scrapers ────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PenguinAI/0.1

# ── ML / AI ──────────────────────────────────────────────────────
GEMMA_MODEL_PATH=/models/gemma4
GEMMA_API_URL=                     # leave blank for local inference
GEMMA_API_KEY=                     # used only if GEMMA_API_URL is set
FINBERT_MODEL=ProsusAI/finbert
ML_WORKER_CONCURRENCY=2

# ── OAuth (future) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
