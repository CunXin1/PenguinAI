# ── App ──────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string_in_production
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ── Database ─────────────────────────────────────────────────────
DB_PASSWORD=penguinai_dev
DATABASE_URL=postgresql+asyncpg://penguinai:penguinai_dev@localhost:5432/penguinai

# ── Redis / Celery ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Rate limiting (per IP, Redis-backed) ────────────────────────
# RATE_LIMIT_LOGIN_TIMES=10         # max login attempts per window
# RATE_LIMIT_LOGIN_WINDOW=60        # window in seconds
# RATE_LIMIT_REGISTER_TIMES=5
# RATE_LIMIT_REGISTER_WINDOW=3600
# RATE_LIMIT_FORGOT_PW_TIMES=5
# RATE_LIMIT_FORGOT_PW_WINDOW=3600
# RATE_LIMIT_RESET_PW_TIMES=5
# RATE_LIMIT_RESET_PW_WINDOW=3600
# RATE_LIMIT_ACCOUNT_LOGIN_TIMES=20   # per account regardless of IP
# RATE_LIMIT_ACCOUNT_LOGIN_WINDOW=3600

# ── Data APIs ────────────────────────────────────────────────────
# Legacy placeholder — no polygon_loader.py exists; superseded by Massive.
POLYGON_API_KEY=
# Massive (massive.com) — $29 Starter gives minute history (15-min delayed).
# Used by data/ingestion/massive_minute_parquet.py → data/minute_data/ parquet,
# plus reference/market-cap backfill and ml.tasks.symbol_validation.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
# Finnhub (free tier) — earnings calendar → earnings table.
# Used by data/ingestion/finnhub_earnings.py (make fetch-earnings) + Celery fetch_earnings.
FINNHUB_API_KEY=
# FRED (St. Louis Fed) — free key, instant signup. Powers fed funds rate history
# (FOMC rate chart) and the VIX-close fallback for the Fear & Greed index.
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html — optional but
# recommended: without it, rate history falls back to a hardcoded table that
# silently goes stale, and the VIX fallback loses one of its backup sources.
FRED_API_KEY=
IBKR_HOST=127.0.0.1
IBKR_PORT=7497              # 7496/7497 TWS live/paper · 4001/4002 Gateway live/paper
IBKR_CLIENT_ID=1
# Tickers the real-time stream (data/ingestion/ibkr_stream.py) subscribes to (Top-30, ETFs first)
IBKR_TICKERS=QQQ,SPY,IWM,DIA,NVDA,AAPL,MSFT,AMZN,GOOGL,META,TSLA,AVGO,AMD,NFLX,PLTR,COIN,MU,QCOM,JPM,V,GS,LLY,UNH,XOM,CVX,COST,WMT,BAC,ORCL,CRM

# ── News Ingestion ───────────────────────────────────────────────
# Tiered fetch: tier-1 (MAG7 + top ETFs) more frequent, tier-2 (rest) less.
# Source priority: Massive (paid) → Google RSS (free) → Finnhub (free, last resort).
NEWS_TIER1_INTERVAL_MIN=15         # fetch interval for tier-1 tickers (minutes)
NEWS_TIER2_INTERVAL_MIN=60         # fetch interval for tier-2 tickers (minutes)
NEWS_MAX_PER_TICKER=50             # max articles kept per ticker in DB
NEWS_MAX_PER_TICKER_FEED=3         # max articles per ticker on /news feed page
NEXT_PUBLIC_NEWS_MAX_PER_TICKER_FEED=3  # same value, exposed to Next.js frontend

# ── Fear & Greed / Volatility ────────────────────────────────────
# All free, no API key needed (CNN graphdata JSON + CBOE daily CSVs; FRED above
# is an optional VIX backup). Source URLs live in data/fear_greed/{cnn,cboe}.py.
# Trigger a manual refresh with `make fetch-fear-greed`.
# FEAR_GREED_REFRESH_MIN=60   # how often the scheduler refreshes the index (minutes)

# ── FOMC (optional display tuning) ───────────────────────────────
# Defaults shown; override only to change how much history the FOMC page renders.
# FOMC_DEFAULT_TREND_LIMIT=10
# FOMC_DEFAULT_STATEMENTS_LIMIT=10
# FOMC_DEFAULT_MARKET_REACTION_LIMIT=20
# FOMC_DEFAULT_SCHEDULE_PAST=10
# FOMC_DEFAULT_SCHEDULE_FUTURE=10
# FOMC_DEFAULT_RATE_HISTORY_YEARS=5

# ── Social Media Scrapers ────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PenguinAI/0.1

# ── ML / AI ──────────────────────────────────────────────────────
# Gemma 4 reasoner backend.  auto = ollama on macOS, vllm on Windows/Linux GPU.
#   auto | vllm | ollama | api
LLM_BACKEND=auto
GEMMA_MODEL_VARIANT=e2b            # e2b now; switch to e4b later (same one line)

# vLLM (Windows / Linux GPU). Override VLLM_MODEL with a HF id or local
# finetuned/merged checkpoint path; blank = derived from variant.
VLLM_BASE_URL=http://localhost:8080/v1
VLLM_MODEL=

# Ollama (macOS). Override OLLAMA_MODEL with a custom/finetuned tag (see
# ml/serving/Modelfile.gemma); blank = derived from variant (gemma3n:e2b).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# External API (future) — used only when LLM_BACKEND=api. The plug-in seam.
GEMMA_API_URL=                     # e.g. https://your-endpoint/v1
GEMMA_API_KEY=                     # bearer token, if the endpoint needs one
GEMMA_API_MODEL=gemma-4

GEMMA_MODEL_PATH=/models/gemma4    # legacy; unused by the backend layer
FINBERT_MODEL=ProsusAI/finbert
ML_WORKER_CONCURRENCY=2

# ── Admin seed (auto-created on first startup if no ADMIN user exists) ───
ADMIN_EMAIL=admin@penguinai.com
ADMIN_PASSWORD=                    # leave blank → random password printed to startup log

# ── OAuth (Google + Apple Sign In) ───────────────────────────────
# Backend public origin + frontend origin. The OAuth redirect_uri is
# {OAUTH_REDIRECT_BASE}/api/auth/oauth/{google|apple}/callback — register it
# verbatim in each provider console. FRONTEND_BASE_URL is where users return
# after sign-in AND where verification / password-reset email links point.
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Google: console.cloud.google.com → APIs & Services → Credentials →
# OAuth 2.0 Client ID (Web). Authorized redirect URI:
#   http://localhost:8000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: developer.apple.com (paid program). Create a Services ID (= APPLE_CLIENT_ID),
# enable "Sign in with Apple", add return URL
#   http://localhost:8000/api/auth/oauth/apple/callback
# then create a Sign-in key (.p8) → APPLE_KEY_ID + APPLE_PRIVATE_KEY; APPLE_TEAM_ID is your Team ID.
# Paste the .p8 body as one line with \n between the PEM lines.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# The Apple sign-in button is hidden in the UI until this is true (needs the paid account above).
NEXT_PUBLIC_APPLE_OAUTH_ENABLED=false

# ── Email (verification + password reset) ────────────────────────
# EMAIL_BACKEND=console logs the link to the server log (dev default, no SMTP needed).
# Set EMAIL_BACKEND=smtp + the SMTP_* vars to actually deliver mail.
EMAIL_BACKEND=console
EMAIL_FROM=PenguinAI <no-reply@penguinai.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true        # true for port 587; for port 465 set SMTP_STARTTLS=false and SMTP_SSL=true
SMTP_SSL=false
